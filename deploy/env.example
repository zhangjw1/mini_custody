# Mini Custody local development configuration template.
# Keep real credentials in deploy/config.local.yaml, which is ignored by Git.
APP_ENV=development
HTTP_ADDR=:8080
APP_TIMEZONE=Asia/Shanghai

DATABASE_URL=
CUSTODY_KEYSTORE_FILE=../secrets/custody-root.age
CUSTODY_KEYSTORE_PASSWORD=

SEPOLIA_RPC_URL=
SEPOLIA_RPC_FALLBACK_URL=
SEPOLIA_RPC_TIMEOUT=10s
SEPOLIA_RPC_MAX_ATTEMPTS=3
SEPOLIA_RPC_BASE_DELAY=250ms
SEPOLIA_RPC_MAX_DELAY=3s
SEPOLIA_SCAN_START_BLOCK=
SEPOLIA_CONFIRMATIONS=3
SEPOLIA_SCAN_INTERVAL=12s
SEPOLIA_SCAN_BATCH_SIZE=20
SEPOLIA_EXPLORER_BASE_URL=https://sepolia.etherscan.io

# Circle official Sepolia USDC. Keep disabled until ERC-20 workers are implemented.
ERC20_ENABLED=false
ERC20_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
ERC20_SYMBOL=USDC
ERC20_DECIMALS=6
ERC20_SCAN_START_BLOCK=
ERC20_SCAN_BATCH_SIZE=100
ERC20_CONFIRMATIONS=3
ERC20_SWEEP_ENABLED=false
ERC20_SWEEP_INTERVAL=15s
ERC20_GAS_SAFETY_BPS=2000
ERC20_GAS_TOPUP_MAX_WEI=5000000000000000

# Bitcoin test network: signet or testnet4
BITCOIN_ENABLED=false
BITCOIN_NETWORK=signet
BITCOIN_RPC_URL=http://127.0.0.1:38332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_TIMEOUT=10s
BITCOIN_SCAN_START_BLOCK=
BITCOIN_CONFIRMATIONS=3
BITCOIN_SCAN_BATCH_SIZE=20
BITCOIN_SCAN_INTERVAL=30s
BITCOIN_SWEEP_INTERVAL=30s
BITCOIN_SWEEP_FEE_RATE_SAT_VB=2

PLATFORM_HOT_WALLET_PATH=m/44'/60'/0'/0/0
PLATFORM_MIN_ETH_BALANCE_WEI=10000000000000000

# Read-only Sepolia ERC-20 preflight input. Never put a private key here.
E2E_EXTERNAL_ADDRESS=
